            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_pokemon_id\": 1,\n  \"level\": 50,\n  \"move_ids\": [1, 2]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/my-pokemon/catch/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "my-pokemon", "catch", ""]
            },
            "description": "Crea una instancia de MyPokemon. Las stats se calculan automaticamente segun el nivel.\n\nReglas:\n- move_ids: maximo 4 movimientos\n- move_ids: solo movimientos que la especie puede aprender (ver /pokemon/{id}/possible-moves/)\n- nivel: 1-100 (default 50)\n- nickname: opcional\n\nUsar /api/v1/pokemon/{id}/possible-moves/ para obtener los move_ids validos."
          }
        },
