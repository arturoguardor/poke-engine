    {
      "name": "MyPokemon",
      "description": "Instancias de Pokemon propias: CRUD, atrapar, curar. Cada instancia es unica e irrepetible con su propio nivel, stats calculadas y movimientos.",
      "item": [
        {
          "name": "Listar mis Pokemon",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/my-pokemon/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "my-pokemon", ""]
            },
            "description": "Retorna todas las instancias de MyPokemon con sus stats calculadas (hp_current, attack, defense, speed, etc.)."
          }
        },
        {
          "name": "Atrapar Pokemon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
